JWT_SECRET=replace-with-a-random-string-at-least-32-bytes
ADMIN_INITIAL_PASSWORD=admin123
STORAGE_ROOT=./data
SQLITE_PATH=./data/campusclaw.db
CHROMA_URL=http://localhost:8000
PORT=3000

# ===== Embedding (OpenAI-compatible external API) =====
# 外部 embedding 服务配置 —— 替换为你实际使用的服务
EMBED_BASE_URL=https://placeholder.example.com/v1
EMBED_MODEL=placeholder-embedding-model
EMBED_DIM=2048
# EMBED_API_KEY=your-api-key-here  (敏感信息，不要提交到版本控制)

# ===== LLM Chat (OpenAI-compatible external API) =====
# 外部大模型对话服务配置 —— 用于教师端知识问答 (RAG)
# 不配置时 /kbs/qa 接口返回 HTTP 503
LLM_BASE_URL=https://placeholder.example.com/v1
LLM_MODEL=placeholder-llm-model
# LLM_API_KEY=your-api-key-here  (敏感信息，不要提交到版本控制)